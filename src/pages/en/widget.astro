---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/visa-cost/" title="Australian visa cost calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free Australian visa cost calculator on your site" description="Put the free Australian visa cost calculator on an employer, university or community site: one iframe, every subclass and family member, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the visa cost calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For employers sponsoring staff, universities with international students, and community groups helping families.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Every subclass, every family member</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the calculator as it is, without warranty. When the Regulations change, the frame follows. Inputs stay in the visitor's browser, and the frame sets no cookie. It states that the site is independent of the Department of Home Affairs. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/visa-cost/" title="Australian visa cost calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
